# Copy to .env and adjust. Every value here overrides backend/autodj/config/default.yaml.
# Nested settings use a double underscore, e.g. AUTODJ_ANALYSIS__SAMPLE_RATE=44100.

AUTODJ_DATABASE_URL=postgresql+psycopg://autodj:autodj@localhost:5432/autodj

# Read-only source library. Never committed, never modified by AutoDJ.
AUTODJ_AUDIO_LIBRARY_DIR=./audio

# Generated mixes and transition excerpts.
AUTODJ_RENDER_CACHE_DIR=./render_cache

AUTODJ_LOG_LEVEL=INFO
AUTODJ_LOG_FORMAT=console
